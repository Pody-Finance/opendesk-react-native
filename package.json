{
  "name": "opendesk-react-native",
  "version": "0.1.5",
  "description": "React Native SDK for openDesk live chat: headless client, realtime, hooks and a drop-in chat screen.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "!src/**/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "example": "vite --config example/vite.config.ts"
  },
  "keywords": [
    "opendesk",
    "react-native",
    "live-chat",
    "support"
  ],
  "license": "MIT",
  "dependencies": {
    "phoenix": "^1.8.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@types/phoenix": "^1.6.6",
    "@types/react": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.3.1",
    "react-native": "^0.81.0",
    "react-native-web": "^0.21.4",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  }
}
